# Copy to /etc/flatmeals.env on the server, fill in, then:  sudo chmod 600 /etc/flatmeals.env
# Lines are NAME=value with no spaces around "=" and no quotes.
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Dhaka
DB_HOST=localhost
DB_PORT=3306
DB_NAME=flatmeals
DB_USER=flatmeals
DB_PASSWORD=put-the-database-password-here
JWT_SECRET=put-a-long-random-value-here-at-least-32-characters
MANAGER_NAME=Your Name
MANAGER_USERNAME=manager
MANAGER_PASSWORD=put-your-first-password-here
